QWidget {
    font-family: Roboto;
    font-size: 14px;
}
QPushButton {
    background-color: #1976D2;
    color: white;
    padding: 8px;
    border-radius: 4px;
}
QPushButton:hover {
    background-color: #1565C0;
}
QLineEdit {
    padding: 8px;
    border: 1px solid #1976D2;
    border-radius: 4px;
}
QTableWidget {
    border: 1px solid #ECEFF1;
}
QComboBox {
    padding: 8px;
    border: 1px solid #1976D2;
    border-radius: 4px;
}
QDateEdit {
    padding: 8px;
    border: 1px solid #1976D2;
    border-radius: 4px;
}
QDoubleSpinBox {
    padding: 8px;
    border: 1px solid #1976D2;
    border-radius: 4px;
}
QLabel {
    color: #1976D2;
}